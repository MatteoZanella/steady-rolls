<section class="steady-strike-fast-forward">
    <p class="hint">{{ localize "STEADY_STRIKE.Settings.FastForward.Hint" key=key }}</p>
    <fieldset>
        <legend>{{ localize "STEADY_STRIKE.Settings.FastForward.Legend" }}</legend>
        <div class="steady-strike-columns">
            <label class="steady-strike-column steady-strike-all">
                <span>{{ localize "STEADY_STRIKE.Settings.FastForward.All" }}</span>
                <input type="checkbox" data-all>
            </label>
            {{#each types}}
            <label class="steady-strike-column">
                <span>{{ localize label }}</span>
                <input type="checkbox" name="{{ type }}" {{ checked checked }}>
            </label>
            {{/each}}
        </div>
    </fieldset>
</section>
